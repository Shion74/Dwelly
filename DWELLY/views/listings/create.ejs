<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        main {
            flex: 1 0 auto;
        }
        footer {
            flex-shrink: 0;
            background: #2c3e50;
            color: white;
            text-align: center;
            padding: 1rem;
            margin-top: auto;
        }
        .form-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 2rem;
        }
        .form-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        .form-card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            padding: 2rem;
            margin-bottom: 2rem;
        }
        .form-section {
            margin-bottom: 1.5rem;
        }
        .form-section:last-child {
            margin-bottom: 0;
        }
        .form-section h3 {
            color: #2c3e50;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #eee;
        }
        .form-group {
            margin-bottom: 1.5rem;
        }
        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: bold;
            color: #2c3e50;
        }
        .form-label.required::after {
            content: " *";
            color: #e74c3c;
        }
        .form-control {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }
        .form-control:focus {
            border-color: #3498db;
            outline: none;
        }
        .form-text {
            font-size: 0.875rem;
            color: #7f8c8d;
            margin-top: 0.25rem;
        }
        .photo-upload {
            border: 2px dashed #ddd;
            border-radius: 5px;
            padding: 2rem;
            text-align: center;
            margin-bottom: 1rem;
            cursor: pointer;
            transition: border-color 0.3s ease;
        }
        .photo-upload:hover {
            border-color: #3498db;
        }
        .photo-preview {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }
        .photo-item {
            position: relative;
            height: 150px;
            border-radius: 5px;
            overflow: hidden;
        }
        .photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .photo-remove {
            position: absolute;
            top: 5px;
            right: 5px;
            background: rgba(0,0,0,0.5);
            color: white;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .btn {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        .btn-primary {
            background: #3498db;
            color: white;
        }
        .btn-primary:hover {
            background: #2980b9;
        }
        .btn-secondary {
            background: #95a5a6;
            color: white;
        }
        .btn-secondary:hover {
            background: #7f8c8d;
        }
        .form-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 2rem;
        }
        .alert {
            padding: 1rem;
            border-radius: 5px;
            margin-bottom: 1rem;
        }
        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .amenities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 0.5rem;
        }
        .amenity-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .amenity-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
        }
        .amenity-item label {
            margin: 0;
            font-weight: normal;
        }
        /* Add styles for the search box */
        .leaflet-control-geocoder {
            width: 300px !important;
            max-width: 90vw !important;
        }
        .leaflet-control-geocoder-form input {
            width: 100% !important;
            padding: 8px !important;
        }
        .distance-circle {
            stroke: #3498db;
            stroke-width: 2;
            fill: rgba(52, 152, 219, 0.1);
        }
        .map-instructions {
            background: white;
            padding: 10px;
            border-radius: 4px;
            box-shadow: 0 1px 5px rgba(0,0,0,0.2);
            margin-bottom: 10px;
            font-size: 0.9em;
            color: #666;
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <div class="logo">
                <h1>Dwelly</h1>
            </div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/favorites">Favorites</a>
                <a href="/users/profile">Profile</a>
                <a href="/auth/logout">Logout</a>
            </div>
        </nav>
    </header>

    <main>
        <div class="form-container">
            <div class="form-header">
                <h1>Create a New Listing</h1>
                <p>Fill in the details below to post your student housing listing</p>
            </div>

            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                <div class="alert alert-danger">
                    <ul style="margin: 0; padding-left: 1rem;">
                        <% errors.forEach(function(error) { %>
                            <li><%= error %></li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>

            <% if (messages.error) { %>
                <div class="alert alert-danger">
                    <%= messages.error %>
                </div>
            <% } %>

            <% if (messages.success) { %>
                <div class="alert alert-success">
                    <%= messages.success %>
                </div>
            <% } %>

            <form action="/listings/create" method="POST" enctype="multipart/form-data" id="listingForm">
                <div class="form-card">
                    <div class="form-section">
                        <h3>Photos</h3>
                        <div class="form-group">
                            <label class="form-label required">Upload Photos (2-6)</label>
                            <div class="photo-upload" id="photoUpload">
                                <p>Click to select photos or drag and drop</p>
                                <input type="file" name="photos" id="photos" multiple accept="image/*" style="display: none;">
                            </div>
                            <div class="photo-preview" id="photoPreview"></div>
                            <div class="form-text">Upload between 2 and 6 photos of your property. Supported formats: JPG, PNG, WebP. Max size: 5MB per image.</div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3>Property Details</h3>
                        <div class="form-group">
                            <label class="form-label required" for="type_id">Type of Rental</label>
                            <select class="form-control" id="type_id" name="type_id" required>
                                <option value="">Select a type</option>
                                <% roomTypes.forEach(function(type) { %>
                                    <option value="<%= type.type_id %>" <%= formData && formData.type_id == type.type_id ? 'selected' : '' %>>
                                        <%= type.display_name %>
                                    </option>
                                <% }); %>
                            </select>
                            <div class="form-text">Choose the type of accommodation you're offering. This helps tenants find exactly what they're looking for.</div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="price">Monthly Rent (PHP)</label>
                            <input type="number" class="form-control" id="price" name="price" min="0" step="0.01" placeholder="Enter monthly rent amount" value="<%= formData && formData.price ? formData.price : '' %>">
                            <div class="form-text">Specify the monthly rent amount in Philippine Pesos (₱).</div>
                        </div>

                        <div class="form-group">
                            <label class="form-label required" for="number_of_rooms">Number of Rooms</label>
                            <input type="number" class="form-control" id="number_of_rooms" name="number_of_rooms" min="1" required value="<%= formData && formData.number_of_rooms ? formData.number_of_rooms : '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label required" for="bathroom_type">Bathroom Type</label>
                            <select class="form-control" id="bathroom_type" name="bathroom_type" required>
                                <option value="">Select bathroom type</option>
                                <option value="common" <%= formData && formData.bathroom_type === 'common' ? 'selected' : '' %>>Common Bathroom</option>
                                <option value="own" <%= formData && formData.bathroom_type === 'own' ? 'selected' : '' %>>Own Bathroom</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label required" for="room_type">Room Type</label>
                            <select class="form-control" id="room_type" name="room_type" required>
                                <option value="">Select room type</option>
                                <option value="bare" <%= formData && formData.room_type === 'bare' ? 'selected' : '' %>>Bare Room</option>
                                <option value="semi_furnished" <%= formData && formData.room_type === 'semi_furnished' ? 'selected' : '' %>>Semi-Furnished</option>
                                <option value="furnished" <%= formData && formData.room_type === 'furnished' ? 'selected' : '' %>>Furnished</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Amenities</label>
                            <div class="amenities-grid">
                                <div class="amenity-item">
                                    <input type="checkbox" id="has_wifi" name="has_wifi" <%= formData && formData.has_wifi ? 'checked' : '' %>>
                                    <label for="has_wifi">WiFi</label>
                                </div>
                                <div class="amenity-item">
                                    <input type="checkbox" id="has_cctv" name="has_cctv" <%= formData && formData.has_cctv ? 'checked' : '' %>>
                                    <label for="has_cctv">CCTV</label>
                                </div>
                                <div class="amenity-item">
                                    <input type="checkbox" id="is_airconditioned" name="is_airconditioned" <%= formData && formData.is_airconditioned ? 'checked' : '' %>>
                                    <label for="is_airconditioned">Airconditioned</label>
                                </div>
                                <div class="amenity-item">
                                    <input type="checkbox" id="has_parking" name="has_parking" <%= formData && formData.has_parking ? 'checked' : '' %>>
                                    <label for="has_parking">Parking</label>
                                </div>
                                <div class="amenity-item">
                                    <input type="checkbox" id="has_own_electricity" name="has_own_electricity" <%= formData && formData.has_own_electricity ? 'checked' : '' %>>
                                    <label for="has_own_electricity">Own Electricity Meter</label>
                                </div>
                                <div class="amenity-item">
                                    <input type="checkbox" id="has_own_water" name="has_own_water" <%= formData && formData.has_own_water ? 'checked' : '' %>>
                                    <label for="has_own_water">Own Water Meter</label>
                                </div>
                            </div>
                            <div class="form-group" style="margin-top:1rem;">
                                <label class="form-label">Other Amenities</label>
                                <div style="display:flex; gap:0.5rem;">
                                    <input type="text" id="customAmenityInput" class="form-control" placeholder="Add custom amenity...">
                                    <button type="button" id="addCustomAmenity" class="btn btn-secondary">Add</button>
                                </div>
                                <div id="customAmenitiesList" style="margin-top:0.5rem; display:flex; flex-wrap:wrap; gap:0.5rem;"></div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label required" for="street">Street Address</label>
                            <input type="text" class="form-control" id="street" name="street" required value="<%= formData ? formData.street : '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="building_name">Building Name (if applicable)</label>
                            <input type="text" class="form-control" id="building_name" name="building_name" value="<%= formData && formData.building_name ? formData.building_name : '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="unit_number">Unit Number (if applicable)</label>
                            <input type="text" class="form-control" id="unit_number" name="unit_number" value="<%= formData && formData.unit_number ? formData.unit_number : '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="maps_link">Google/Apple Maps Link</label>
                            <input
                                type="url"
                                class="form-control"
                                id="maps_link"
                                name="maps_link"
                                value="<%= formData && formData.maps_link ? formData.maps_link : '' %>"
                                placeholder="e.g. https://maps.app.goo.gl/8FxdZA3SrtzYczLe6"
                                pattern="(@?https?:\/\/(maps\.app\.goo\.gl|goo\.gl\/maps|maps\.apple\.com)\/.*)?"
                            >
                            <div class="form-text">
                                Paste the full Google Maps or Apple Maps link. If your link starts with <b>@</b>, remove the <b>@</b>.
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label required" for="barangay">Barangay</label>
                            <input type="text" class="form-control" id="barangay" name="barangay" required value="<%= formData ? formData.barangay : '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="description">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="4"><%= formData && formData.description ? formData.description : '' %></textarea>
                            <div class="form-text">Describe the property, its features, and any important details potential tenants should know.</div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3>Location</h3>
                        <div class="form-group">
                            <label class="form-label">Map Location</label>
                            <div id="map" style="height: 400px; margin-bottom: 1rem;"></div>
                            <input type="hidden" id="latitude" name="latitude" value="<%= formData && formData.latitude ? formData.latitude : '' %>">
                            <input type="hidden" id="longitude" name="longitude" value="<%= formData && formData.longitude ? formData.longitude : '' %>">
                            <div class="form-text">Click on the map to set the exact location of your property.</div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3>Contact Information</h3>
                        <div class="form-group">
                            <label class="form-label required" for="landlord_name">Landlord Full Name</label>
                            <input type="text" class="form-control" id="landlord_name" name="landlord_name" required value="<%= formData ? formData.landlord_name : '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label required" for="contact_number">Contact Number</label>
                            <input type="tel" class="form-control" id="contact_number" name="contact_number" required value="<%= formData ? formData.contact_number : '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="social_media_link">Social Media Link (Optional)</label>
                            <input type="url" class="form-control" id="social_media_link" name="social_media_link" placeholder="https://facebook.com/..." value="<%= formData ? formData.social_media_link : '' %>">
                            <div class="form-text">Add a link to your Facebook, Instagram, or other social media profile.</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Create Listing</button>
                    </div>
                </div>
            </form>
        </div>
    </main>

    <footer>
        <p>&copy; 2024 Dwelly. All rights reserved.</p>
    </footer>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Add Leaflet Control Search -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
    <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const photoUpload = document.getElementById('photoUpload');
            const photosInput = document.getElementById('photos');
            const photoPreview = document.getElementById('photoPreview');
            const listingForm = document.getElementById('listingForm');
            
            // Handle photo upload click
            photoUpload.addEventListener('click', function() {
                photosInput.click();
            });
            
            // Handle drag and drop
            photoUpload.addEventListener('dragover', function(e) {
                e.preventDefault();
                photoUpload.style.borderColor = '#3498db';
            });
            
            photoUpload.addEventListener('dragleave', function() {
                photoUpload.style.borderColor = '#ddd';
            });
            
            photoUpload.addEventListener('drop', function(e) {
                e.preventDefault();
                photoUpload.style.borderColor = '#ddd';
                
                if (e.dataTransfer.files.length) {
                    photosInput.files = e.dataTransfer.files;
                    updatePhotoPreview();
                }
            });
            
            // Handle file selection
            photosInput.addEventListener('change', updatePhotoPreview);
            
            // Update photo preview
            function updatePhotoPreview() {
                photoPreview.innerHTML = '';
                
                if (photosInput.files.length > 6) {
                    alert('You can only upload a maximum of 6 photos');
                    photosInput.value = '';
                    return;
                }
                
                for (let i = 0; i < photosInput.files.length; i++) {
                    const file = photosInput.files[i];
                    const reader = new FileReader();
                    
                    reader.onload = function(e) {
                        const photoItem = document.createElement('div');
                        photoItem.className = 'photo-item';
                        
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        
                        const removeBtn = document.createElement('button');
                        removeBtn.className = 'photo-remove';
                        removeBtn.innerHTML = '&times;';
                        removeBtn.addEventListener('click', function() {
                            // Create a new FileList without this file
                            const dt = new DataTransfer();
                            const { files } = photosInput;
                            
                            for (let j = 0; j < files.length; j++) {
                                if (j !== i) {
                                    dt.items.add(files[j]);
                                }
                            }
                            
                            photosInput.files = dt.files;
                            updatePhotoPreview();
                        });
                        
                        photoItem.appendChild(img);
                        photoItem.appendChild(removeBtn);
                        photoPreview.appendChild(photoItem);
                    };
                    
                    reader.readAsDataURL(file);
                }
            }
            
            // Form validation
            listingForm.addEventListener('submit', function(e) {
                if (photosInput.files.length < 2) {
                    e.preventDefault();
                    alert('Please upload at least 2 photos');
                }
            });

            // Initialize map
            const map = L.map('map').setView([7.0633, 125.5956], 14);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 18,
                minZoom: 12
            }).addTo(map);

            // Add search control
            const geocoder = L.Control.geocoder({
                defaultMarkGeocode: false,
                placeholder: 'Search for a location in Davao City...',
                errorMessage: 'No results found.',
                geocoder: L.Control.Geocoder.nominatim({
                    bounds: L.latLngBounds(
                        [7.0, 125.4], // Southwest corner of Davao City
                        [7.2, 125.7]  // Northeast corner of Davao City
                    )
                })
            }).on('markgeocode', function(e) {
                const latlng = e.geocode.center;
                // Only allow locations within Davao City bounds
                if (latlng.lat >= 7.0 && latlng.lat <= 7.2 && 
                    latlng.lng >= 125.4 && latlng.lng <= 125.7) {
                    updateMarker(latlng);
                } else {
                    alert('Please select a location within Davao City');
                }
            }).addTo(map);

            // Add Mapúa marker
            const mapuaMarker = L.marker([7.0633, 125.5956]).addTo(map);
            mapuaMarker.bindPopup('<strong>Mapúa Malayan Colleges Mindanao</strong><br>Reference point for student housing').openPopup();

            // Add distance circle (1km radius)
            let distanceCircle = L.circle([7.0633, 125.5956], {
                radius: 1000,
                className: 'distance-circle'
            }).addTo(map);

            let marker = null;
            const latitudeInput = document.getElementById('latitude');
            const longitudeInput = document.getElementById('longitude');

            // Function to update marker and inputs
            function updateMarker(latlng) {
                if (marker) {
                    marker.setLatLng(latlng);
                } else {
                    marker = L.marker(latlng, {
                        draggable: true
                    }).addTo(map);
                    
                    // Add drag end event
                    marker.on('dragend', function(e) {
                        const newLatLng = e.target.getLatLng();
                        updateInputs(newLatLng);
                    });
                }
                updateInputs(latlng);
                map.setView(latlng, 15);
            }

            // Function to update input values
            function updateInputs(latlng) {
                latitudeInput.value = latlng.lat.toFixed(6);
                longitudeInput.value = latlng.lng.toFixed(6);
            }

            // Add marker if coordinates exist
            if (latitudeInput.value && longitudeInput.value) {
                updateMarker([latitudeInput.value, longitudeInput.value]);
            }

            // Handle map click
            map.on('click', function(e) {
                const latlng = e.latlng;
                // Only allow clicks within Davao City bounds
                if (latlng.lat >= 7.0 && latlng.lat <= 7.2 && 
                    latlng.lng >= 125.4 && latlng.lng <= 125.7) {
                    updateMarker(latlng);
                } else {
                    alert('Please select a location within Davao City');
                }
            });

            // Add instructions to the map
            const instructions = L.control({ position: 'topright' });
            instructions.onAdd = function() {
                const div = L.DomUtil.create('div', 'map-instructions');
                div.innerHTML = '<strong>Instructions:</strong><br>' +
                               '1. Click on the map to set location<br>' +
                               '2. Or use the search box above<br>' +
                               '3. Drag the marker to adjust<br>' +
                               '4. Blue circle shows 1km radius from Mapúa';
                return div;
            };
            instructions.addTo(map);

            // Custom amenities logic
            const customAmenityInput = document.getElementById('customAmenityInput');
            const addCustomAmenityBtn = document.getElementById('addCustomAmenity');
            const customAmenitiesList = document.getElementById('customAmenitiesList');

            let customAmenities = [];

            addCustomAmenityBtn.addEventListener('click', function() {
                const value = customAmenityInput.value.trim();
                if (value && !customAmenities.includes(value)) {
                    customAmenities.push(value);
                    renderCustomAmenities();
                    customAmenityInput.value = '';
                }
            });

            function renderCustomAmenities() {
                customAmenitiesList.innerHTML = '';
                customAmenities.forEach((amenity, idx) => {
                    const tag = document.createElement('span');
                    tag.className = 'amenity-tag';
                    tag.textContent = amenity;
                    const removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.textContent = '×';
                    removeBtn.style.marginLeft = '0.5rem';
                    removeBtn.style.background = 'none';
                    removeBtn.style.border = 'none';
                    removeBtn.style.color = '#e74c3c';
                    removeBtn.style.cursor = 'pointer';
                    removeBtn.onclick = function() {
                        customAmenities.splice(idx, 1);
                        renderCustomAmenities();
                    };
                    tag.appendChild(removeBtn);
                    customAmenitiesList.appendChild(tag);
                });
            }

            // On form submit, add custom amenities as hidden inputs
            listingForm.addEventListener('submit', function() {
                // Remove any previous hidden inputs
                document.querySelectorAll('input[name="custom_amenities[]"]').forEach(e => e.remove());
                customAmenities.forEach(amenity => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'custom_amenities[]';
                    input.value = amenity;
                    listingForm.appendChild(input);
                });
            });
        });
    </script>
</body>
</html> 