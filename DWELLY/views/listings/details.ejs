<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <style>
        .success-message {
            background-color: #d4edda;
            color: #155724;
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 5px;
            border: 1px solid #c3e6cb;
        }
        .listing-container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 2rem;
        }
        .listing-header {
            margin-bottom: 2rem;
        }
        .listing-title {
            font-size: 2rem;
            color: #2c3e50;
            margin-bottom: 0.5rem;
        }
        .listing-meta {
            color: #7f8c8d;
            font-size: 0.9rem;
        }
        .listing-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }
        .listing-photos {
            position: sticky;
            top: 2rem;
        }
        .main-photo {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 10px;
            margin-bottom: 1rem;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .photo-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
        }
        .photo-thumbnail {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border-radius: 5px;
            cursor: pointer;
            transition: opacity 0.3s ease;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .photo-thumbnail:hover {
            opacity: 0.8;
        }
        .listing-details {
            position: sticky;
            top: 2rem;
        }
        .listing-info {
            background: white;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .info-section {
            margin-bottom: 1.5rem;
        }
        .info-section:last-child {
            margin-bottom: 0;
        }
        .info-section h3 {
            color: #2c3e50;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #eee;
        }
        .info-field {
            display: flex;
            margin-bottom: 0.5rem;
        }
        .info-label {
            width: 120px;
            font-weight: bold;
            color: #7f8c8d;
        }
        .info-value {
            flex: 1;
            color: #2c3e50;
        }
        .action-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }
        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }
        .btn-primary {
            background: #3498db;
            color: white;
        }
        .btn-primary:hover {
            background: #2980b9;
        }
        .btn-secondary {
            background: #95a5a6;
            color: white;
        }
        .btn-secondary:hover {
            background: #7f8c8d;
        }
        .btn-danger {
            background: #e74c3c;
            color: white;
        }
        .btn-danger:hover {
            background: #c0392b;
        }

        @media (max-width: 768px) {
            .listing-content {
                grid-template-columns: 1fr;
            }
            .listing-photos, .listing-details {
                position: static;
            }
        }

        .photo-actions {
            position: relative;
            z-index: 1000;
            background: white;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
            padding: 0.5rem;
            pointer-events: auto;
        }

        .action-icon {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.2s ease;
            background: none;
            color: #7f8c8d;
            font-size: 1rem;
        }

        .action-icon:hover {
            background: #f8f9fa;
            color: #3498db;
        }

        .action-icon#favoriteBtn {
            color: #7f8c8d;
        }

        .action-icon#favoriteBtn:hover {
            color: #e74c3c;
            background: #fef2f2;
        }

        .action-icon#favoriteBtn.active {
            color: #e74c3c;
            background: #fef2f2;
        }

        .action-icon#favoriteBtn.active i {
            color: #e74c3c;
        }

        .action-icon#favoriteBtn.active:hover {
            background: #fee2e2;
        }

        .action-icon i {
            font-size: 1.2rem;
        }

        .action-icon span {
            font-size: 0.9rem;
        }

        .rating-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }

        .rating-modal.active {
            display: flex;
        }

        .rating-content {
            background: white;
            padding: 2rem;
            border-radius: 10px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .rating-stars {
            display: flex;
            gap: 0.5rem;
            margin: 1.5rem 0;
            font-size: 2rem;
            justify-content: center;
        }

        .rating-stars i {
            cursor: pointer;
            color: #ddd;
            transition: all 0.2s ease;
        }

        .rating-stars i:hover {
            transform: scale(1.1);
        }

        .rating-stars i.active {
            color: #f1c40f;
        }

        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .modal-buttons button {
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
            transition: background-color 0.2s ease;
        }

        .modal-buttons .btn-secondary {
            background: #95a5a6;
            color: white;
        }

        .modal-buttons .btn-secondary:hover {
            background: #7f8c8d;
        }

        .modal-buttons .btn-primary {
            background: #3498db;
            color: white;
        }

        .modal-buttons .btn-primary:hover {
            background: #2980b9;
        }

        .modal-buttons .btn-danger {
            background: #e74c3c;
            color: white;
        }

        .modal-buttons .btn-danger:hover {
            background: #c0392b;
        }

        textarea {
            width: 100%;
            min-height: 100px;
            padding: 0.75rem;
            border: 1px solid #ddd;
            border-radius: 5px;
            resize: vertical;
            font-family: inherit;
            font-size: 1rem;
            margin: 1rem 0;
        }

        textarea:focus {
            outline: none;
            border-color: #3498db;
            box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.2);
        }

        .photo-viewer-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .photo-viewer-content {
            position: relative;
            width: 90%;
            height: 90%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .photo-viewer-image {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .photo-viewer-nav {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 100%;
            display: flex;
            justify-content: space-between;
            padding: 0 2rem;
        }

        .photo-viewer-nav button {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            padding: 1rem;
            cursor: pointer;
            border-radius: 50%;
            transition: background 0.3s ease;
        }

        .photo-viewer-nav button:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .photo-viewer-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            padding: 0.5rem 1rem;
            cursor: pointer;
            border-radius: 5px;
            transition: background 0.3s ease;
        }

        .photo-viewer-close:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .photo-viewer-counter {
            position: absolute;
            bottom: 1rem;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            background: rgba(0, 0, 0, 0.5);
            padding: 0.5rem 1rem;
            border-radius: 20px;
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <div class="logo">
                <h1>Dwelly</h1>
            </div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/favorites">Favorites</a>
                <a href="/users/profile">Profile</a>
                <a href="/auth/logout">Logout</a>
            </div>
        </nav>
    </header>

    <main>
        <div class="listing-container">
            <% if (success) { %>
                <div class="success-message">
                    <%= success %>
                </div>
            <% } %>

            <% if (typeof messages !== 'undefined' && messages.error) { %>
                <div class="error-message" style="background-color: #f8d7da; color: #721c24; padding: 1rem; margin-bottom: 1rem; border-radius: 5px; border: 1px solid #f5c6cb;">
                    <%= messages.error %>
                </div>
            <% } %>

            <div class="listing-header">
                <h1 class="listing-title"><%= listing.type %></h1>
                <div class="listing-meta">
                    Posted by <%= listing.poster_name %> • 
                    <%= new Date(listing.created_at).toLocaleDateString() %>
                </div>
            </div>

            <div class="listing-content">
                <div class="listing-photos">
                    <% if (photos && photos.length > 0) { %>
                        <img src="<%= photos[0].file_path %>" alt="Main photo" class="main-photo">
                        <div class="photo-grid">
                            <% photos.forEach((photo, index) => { %>
                                <img src="<%= photo.file_path %>" alt="Photo <%= index + 1 %>" class="photo-thumbnail">
                            <% }); %>
                        </div>
                    <% } else { %>
                        <img src="/images/no-image.jpg" alt="No photo available" class="main-photo">
                    <% } %>

                    <% if (user) { %>
                        <div class="action-buttons" style="display: flex; gap: 1rem; margin-top: 2rem;">
                            <% if (user.id !== listing.user_id) { %>
                                <button class="action-icon <%= isFavorited ? 'active' : '' %>" id="favoriteBtn" data-post-id="<%= listing.post_id %>" style="z-index: 1001; position: relative; pointer-events: auto; display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border: none; border-radius: 5px; cursor: pointer; transition: all 0.3s ease; background: none; color: #7f8c8d;">
                                    <i class="fas fa-bookmark"></i>
                                    <span><%= listing.favorite_count || 0 %></span>
                                </button>
                                <button class="action-icon" id="rateBtn" style="z-index: 1001; position: relative; pointer-events: auto; display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border: none; border-radius: 5px; cursor: pointer; transition: all 0.3s ease; background: none; color: #7f8c8d;">
                                    <i class="fas fa-star"></i>
                                    <span><%= listing.average_rating ? listing.average_rating.toFixed(1) : 'Rate' %></span>
                                </button>
                                <button class="action-icon" id="reportBtn" style="z-index: 1001; position: relative; pointer-events: auto; display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border: none; border-radius: 5px; cursor: pointer; transition: all 0.3s ease; background: none; color: #7f8c8d;">
                                    <i class="fas fa-flag"></i>
                                </button>
                            <% } else { %>
                                <a href="/listings/<%= listing.post_id %>/edit" class="btn btn-primary" style="padding: 0.75rem 1.5rem; border: none; border-radius: 5px; font-size: 1rem; cursor: pointer; transition: background-color 0.3s ease; text-decoration: none; display: inline-block; text-align: center; background: #3498db; color: white;">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <form action="/listings/<%= listing.post_id %>/delete" method="POST" style="display: inline;" onsubmit="return confirmDelete();">
                                    <button type="submit" class="btn btn-danger" style="padding: 0.75rem 1.5rem; border: none; border-radius: 5px; font-size: 1rem; cursor: pointer; transition: background-color 0.3s ease; text-decoration: none; display: inline-block; text-align: center; background: #e74c3c; color: white;">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    <% } %>

                    <!-- New Map Section -->
                    <div class="info-section" style="margin-top: 2rem;">
                        <h3>Map</h3>
                        <% if (listing.latitude && listing.longitude) { %>
                            <div id="listingMap" 
                                 data-lat="<%= listing.latitude %>" 
                                 data-lng="<%= listing.longitude %>"
                                 data-popup="<%= listing.barangay + ', ' + listing.city %>"
                                 style="height: 400px; width: 100%; border: 2px solid #3498db; border-radius: 10px; background-color: #f8f9fa;">
                            </div>
                        <% } else { %>
                            <div style="padding: 2rem; color: #7f8c8d; text-align: center;">No location set for this listing.</div>
                        <% } %>
                        <button class="btn btn-primary" style="margin-top: 1rem;" onclick="window.open('https://www.google.com/maps/dir/?api=1&origin=<%= listing.latitude %>,<%= listing.longitude %>&destination=7.062694,125.596000', '_blank');">Directions to School</button>
                    </div>
                </div>

                <div class="listing-details">
                    <div class="listing-info">
                        <div class="info-section">
                            <h3>Description</h3>
                            <p><%= listing.description || 'No description provided' %></p>
                        </div>

                        <div class="info-section">
                            <h3>Location</h3>
                            <div class="info-field">
                                <div class="info-label">Street</div>
                                <div class="info-value"><%= listing.street %></div>
                            </div>
                            <div class="info-field">
                                <div class="info-label">Barangay</div>
                                <div class="info-value"><%= listing.barangay %></div>
                            </div>
                            <div class="info-field">
                                <div class="info-label">City</div>
                                <div class="info-value"><%= listing.city %></div>
                            </div>
                            <% if (listing.building_name) { %>
                                <div class="info-field">
                                    <div class="info-label">Building</div>
                                    <div class="info-value"><%= listing.building_name %></div>
                                </div>
                            <% } %>
                            <% if (listing.unit_number) { %>
                                <div class="info-field">
                                    <div class="info-label">Unit</div>
                                    <div class="info-value"><%= listing.unit_number %></div>
                                </div>
                            <% } %>
                        </div>

                        <div class="info-section">
                            <h3>Amenities</h3>
                            <div class="listing-amenities" style="flex-wrap: wrap; white-space: normal;">
                                <% let hasAmenity = false; %>
                                
                                <% if (typeof allAmenities !== 'undefined' && allAmenities.length > 0) { 
                                    hasAmenity = true;
                                    allAmenities.forEach(amenity => { 
                                        // Choose icon based on amenity name
                                        let icon = 'fas fa-check';
                                        const amenityName = amenity.amenity_name.toLowerCase();
                                        if (amenityName.includes('wifi')) icon = 'fas fa-wifi';
                                        else if (amenityName.includes('cctv')) icon = 'fas fa-video';
                                        else if (amenityName.includes('air') || amenityName.includes('ac')) icon = 'fas fa-snowflake';
                                        else if (amenityName.includes('parking')) icon = 'fas fa-parking';
                                        else if (amenityName.includes('electricity')) icon = 'fas fa-bolt';
                                        else if (amenityName.includes('water')) icon = 'fas fa-tint';
                                %>
                                    <span style="display: inline-block; background: #e1f0ff; color: #3498db; border-radius: 15px; font-size: 0.75rem; padding: 0.25rem 0.5rem; margin-right: 0.25rem; margin-bottom: 0.25rem;">
                                        <i style="font-size: 0.875rem;" class="<%= icon %>"></i> <%= amenity.amenity_name %>
                                    </span>
                                <% });
                                } %>

                                <% if (!hasAmenity) { %>
                                    <span style="color: #7f8c8d;">No amenities listed.</span>
                                <% } %>
                            </div>
                        </div>

                        <div class="info-section">
                            <h3>Contact Information</h3>
                            <div class="info-field">
                                <div class="info-label">Landlord</div>
                                <div class="info-value"><%= listing.landlord_name %></div>
                            </div>
                            <div class="info-field">
                                <div class="info-label">Contact</div>
                                <div class="info-value"><%= listing.contact_number %></div>
                            </div>
                            <% if (listing.social_link) { %>
                                <div class="info-field">
                                    <div class="info-label">Social Media</div>
                                    <div class="info-value">
                                        <a href="<%= listing.social_link %>" target="_blank">View Profile</a>
                                    </div>
                                </div>
                            <% } %>
                            <% if (listing.maps_link) { %>
                                <div class="info-field">
                                    <div class="info-label">Map Location</div>
                                    <div class="info-value">
                                        <a href="<%= listing.maps_link %>" target="_blank" rel="noopener">View on Map</a>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                        <% if (listing.price) { %>
                            <div class="info-section">
                                <h3>Price</h3>
                                <div class="info-value">₱<%= listing.price.toLocaleString() %>/month</div>
                            </div>
                        <% } %>

                        <div class="info-section">
                            <h3>Statistics</h3>
                            <div class="info-field">
                                <div class="info-label">Favorites</div>
                                <div class="info-value"><%= listing.favorite_count || 0 %></div>
                            </div>
                            <div class="info-field">
                                <div class="info-label">Rating</div>
                                <div class="info-value">
                                    <% if (listing.average_rating) { %>
                                        <%= listing.average_rating.toFixed(1) %>/5.0
                                        (<%= listing.rating_count %> reviews)
                                    <% } else { %>
                                        No ratings yet
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <% if (!user) { %>
                            <div class="info-section">
                                <a href="/auth/login" class="btn btn-primary">Login to Interact</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; 2024 Dwelly. All rights reserved.</p>
    </footer>

    <!-- Rating Modal -->
    <div id="ratingModal" class="rating-modal">
        <div class="rating-content">
            <h3>Rate this Listing</h3>
            <div class="rating-stars">
                <i class="far fa-star" data-rating="1"></i>
                <i class="far fa-star" data-rating="2"></i>
                <i class="far fa-star" data-rating="3"></i>
                <i class="far fa-star" data-rating="4"></i>
                <i class="far fa-star" data-rating="5"></i>
            </div>
            <div class="modal-buttons">
                <button class="btn btn-secondary" id="cancelRating">Cancel</button>
                <button class="btn btn-primary" id="submitRating">Submit Rating</button>
            </div>
        </div>
    </div>

    <!-- Report Modal -->
    <div id="reportModal" class="rating-modal">
        <div class="rating-content">
            <h3>Report Listing</h3>
            <form id="reportForm">
                <div style="margin-bottom: 1rem;">
                    <label><input type="radio" name="reportType" value="occupied" required> Occupied</label><br>
                    <label><input type="radio" name="reportType" value="scam"> Scam</label><br>
                    <label><input type="radio" name="reportType" value="other"> Other</label>
                </div>
                <textarea id="reportReason" placeholder="Please describe the reason (required for 'Other')..." style="width: 100%; min-height: 100px; margin: 1rem 0; padding: 0.5rem; display: none;"></textarea>
                <div class="modal-buttons">
                    <button type="button" class="btn btn-secondary" id="cancelReport">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="submitReport">Submit Report</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const mapElement = document.getElementById('listingMap');
        if (!mapElement) return;

        // Get coordinates from data attributes
        const lat = parseFloat(mapElement.dataset.lat);
        const lng = parseFloat(mapElement.dataset.lng);
        const popupText = mapElement.dataset.popup;
        
        // Create and configure map
        const map = L.map('listingMap').setView([lat, lng], 15);
        
        // Add tile layer
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);
        
        // Add marker with popup
        L.marker([lat, lng])
            .addTo(map)
            .bindPopup(popupText)
            .openPopup();
        
        // Ensure map renders correctly
        setTimeout(() => map.invalidateSize(), 100);
    });
    </script>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Helper function to show modal
        function showModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.style.display = 'flex';
                // Add click outside to close
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        hideModal(modalId);
                    }
                });
            }
        }

        // Helper function to hide modal
        function hideModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.style.display = 'none';
            }
        }

        // Favorite Button Functionality
        const favoriteBtn = document.getElementById('favoriteBtn');
        if (favoriteBtn) {
            // Set initial state if already favorited
            if (favoriteBtn.classList.contains('active')) {
                favoriteBtn.style.color = '#e74c3c';
                const icon = favoriteBtn.querySelector('i');
                if (icon) {
                    icon.style.color = '#e74c3c';
                }
            }

            favoriteBtn.addEventListener('click', async function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const listingId = this.dataset.postId;
                if (!listingId) {
                    console.error('No listing ID found');
                    return;
                }

                try {
                    const response = await fetch(`/listings/${listingId}/favorite`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    if (!response.ok) throw new Error('Failed to toggle favorite');
                    
                    const data = await response.json();
                    
                    // Update button state
                    this.classList.toggle('active');
                    const icon = this.querySelector('i');
                    if (icon) {
                        icon.classList.toggle('fas');
                        icon.classList.toggle('far');
                        // Update icon color
                        icon.style.color = this.classList.contains('active') ? '#e74c3c' : '#7f8c8d';
                    }
                    
                    // Update button color
                    this.style.color = this.classList.contains('active') ? '#e74c3c' : '#7f8c8d';
                    
                    // Update favorite count
                    const countSpan = this.querySelector('span');
                    if (countSpan) {
                        const currentCount = parseInt(countSpan.textContent);
                        countSpan.textContent = data.action === 'added' ? currentCount + 1 : currentCount - 1;
                    }

                    // If on favorites page and removed, remove the listing card
                    if (data.action === 'removed' && window.location.pathname === '/favorites') {
                        const card = this.closest('.listing-card');
                        if (card) {
                            card.style.opacity = '0';
                            setTimeout(() => {
                                card.remove();
                                const remainingCards = document.querySelectorAll('.listing-card');
                                if (remainingCards.length === 0) {
                                    const grid = document.querySelector('.listings-grid');
                                    if (grid) {
                                        grid.innerHTML = '<div class="empty-state"><h2>No Favorite Listings Yet</h2><p>Start adding listings to your favorites!</p></div>';
                                    }
                                }
                            }, 300);
                        }
                    }
                } catch (err) {
                    console.error('Error toggling favorite:', err);
                    alert('Failed to update favorite status. Please try again.');
                }
            });
        }

        // Rating Button Functionality
        const rateBtn = document.getElementById('rateBtn');
        const ratingModal = document.getElementById('ratingModal');
        const cancelRating = document.getElementById('cancelRating');
        const submitRating = document.getElementById('submitRating');
        let selectedRating = 0;

        if (rateBtn && ratingModal) {
            // Show rating modal
            rateBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                showModal('ratingModal');
            });

            // Handle star selection
            const stars = ratingModal.querySelectorAll('.rating-stars i');
            stars.forEach(star => {
                star.addEventListener('mouseover', function() {
                    const rating = parseInt(this.dataset.rating);
                    updateStars(rating);
                });

                star.addEventListener('click', function() {
                    selectedRating = parseInt(this.dataset.rating);
                    updateStars(selectedRating);
                });
            });

            ratingModal.querySelector('.rating-stars').addEventListener('mouseleave', function() {
                updateStars(selectedRating);
            });

            // Cancel rating
            cancelRating.addEventListener('click', function() {
                hideModal('ratingModal');
                selectedRating = 0;
                updateStars(0);
            });

            // Submit rating
            submitRating.addEventListener('click', async function() {
                if (!selectedRating) {
                    alert('Please select a rating');
                    return;
                }

                try {
                    const response = await fetch(`/listings/${favoriteBtn.dataset.postId}/rate`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            stars: selectedRating,
                            comment: '' // Optional comment field
                        })
                    });

                    if (!response.ok) {
                        const data = await response.json();
                        throw new Error(data.error || 'Failed to submit rating');
                    }
                    
                    const data = await response.json();
                    
                    // Update rating display
                    const ratingSpan = rateBtn.querySelector('span');
                    if (ratingSpan) {
                        // Find the statistics section and rating info
                        const statsSections = document.querySelectorAll('.info-section');
                        let ratingCount = 0;
                        let currentAverage = 0;

                        // Find the statistics section
                        statsSections.forEach(section => {
                            const heading = section.querySelector('h3');
                            if (heading && heading.textContent === 'Statistics') {
                                // Find the rating field
                                const ratingField = section.querySelector('.info-field');
                                if (ratingField) {
                                    const ratingValue = ratingField.querySelector('.info-value');
                                    if (ratingValue) {
                                        const ratingText = ratingValue.textContent;
                                        // Extract current average and count
                                        const match = ratingText.match(/(\d+\.?\d*)\/5\.0\s*\((\d+)/);
                                        if (match) {
                                            currentAverage = parseFloat(match[1]);
                                            ratingCount = parseInt(match[2]);
                                        }
                                    }
                                }
                            }
                        });

                        // Calculate new average
                        const newCount = ratingCount + 1;
                        const newAverage = ((currentAverage * ratingCount) + selectedRating) / newCount;
                        
                        // Update the rating display
                        ratingSpan.textContent = newAverage.toFixed(1);

                        // Update the statistics section
                        statsSections.forEach(section => {
                            const heading = section.querySelector('h3');
                            if (heading && heading.textContent === 'Statistics') {
                                const ratingField = section.querySelector('.info-field:nth-child(2)');
                                if (ratingField) {
                                    const ratingValue = ratingField.querySelector('.info-value');
                                    if (ratingValue) {
                                        ratingValue.textContent = `${newAverage.toFixed(1)}/5.0 (${newCount} reviews)`;
                                    }
                                }
                            }
                        });
                    }

                    hideModal('ratingModal');
                    selectedRating = 0;
                    updateStars(0);
                    
                    // Show success message
                    alert('Rating submitted successfully!');
                } catch (err) {
                    console.error('Error submitting rating:', err);
                    alert(err.message || 'Failed to submit rating. Please try again.');
                }
            });
        }

        // Report Button Functionality
        const reportBtn = document.getElementById('reportBtn');
        const reportModal = document.getElementById('reportModal');
        const cancelReport = document.getElementById('cancelReport');
        const reportForm = document.getElementById('reportForm');
        const reportReason = document.getElementById('reportReason');

        if (reportBtn && reportModal) {
            // Show report modal
            reportBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                showModal('reportModal');
            });

            // Cancel report
            cancelReport.addEventListener('click', function() {
                hideModal('reportModal');
                reportReason.value = '';
                reportReason.style.display = 'none';
                reportForm.reset();
            });

            // Show/hide reason textarea for 'Other'
            reportForm.addEventListener('change', function(e) {
                const selected = reportForm.reportType.value;
                reportReason.style.display = selected === 'other' ? 'block' : 'none';
            });

            // Submit report
            reportForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const type = reportForm.reportType.value;
                const reason = reportReason.value.trim();
                if (type === 'other' && !reason) {
                    alert('Please provide a reason for "Other".');
                    return;
                }
                try {
                    const response = await fetch(`/listings/${favoriteBtn.dataset.postId}/report`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ type, reason })
                    });
                    if (!response.ok) throw new Error('Failed to submit report');
                    alert('Thank you for your report. We will review it shortly.');
                    hideModal('reportModal');
                    reportReason.value = '';
                    reportReason.style.display = 'none';
                    reportForm.reset();
                } catch (err) {
                    console.error('Error submitting report:', err);
                    alert('Failed to submit report. Please try again.');
                }
            });
        }

        // Helper function to update star display
        function updateStars(rating) {
            const stars = ratingModal.querySelectorAll('.rating-stars i');
            stars.forEach((star, index) => {
                if (index < rating) {
                    star.classList.remove('far');
                    star.classList.add('fas', 'active');
                } else {
                    star.classList.remove('fas', 'active');
                    star.classList.add('far');
                }
            });
        }
    });

    // Strong confirmation for post deletion
    function confirmDelete() {
        const confirmMessage = `⚠️ WARNING: This will permanently delete your listing!\n\nThis action will:\n• Archive your listing data for record keeping\n• Remove the listing from public view\n• Delete all photos and related data\n• Remove all favorites and ratings for this listing\n\nThis action CANNOT be undone!\n\nTo confirm deletion, please type "DELETE" (without quotes) in the box below:`;
        
        const confirmation = prompt(confirmMessage);
        
        if (confirmation && confirmation.toUpperCase() === 'DELETE') {
            return true; // Allow form submission
        } else {
            alert('Deletion cancelled. You must type "DELETE" (case-insensitive) to confirm.');
            return false; // Prevent form submission
        }
    }
    </script>
</body>
</html> 