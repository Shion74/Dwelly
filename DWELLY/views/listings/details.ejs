<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <style>
        .success-message {
            background-color: #d4edda;
            color: #155724;
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 5px;
            border: 1px solid #c3e6cb;
        }
        .listing-container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 2rem;
        }
        .listing-header {
            margin-bottom: 2rem;
        }
        .listing-title {
            font-size: 2rem;
            color: #2c3e50;
            margin-bottom: 0.5rem;
        }
        .listing-meta {
            color: #7f8c8d;
            font-size: 0.9rem;
        }
        .listing-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }
        .listing-photos {
            position: sticky;
            top: 2rem;
        }
        .main-photo {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 10px;
            margin-bottom: 1rem;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .photo-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
        }
        .photo-thumbnail {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border-radius: 5px;
            cursor: pointer;
            transition: opacity 0.3s ease;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .photo-thumbnail:hover {
            opacity: 0.8;
        }
        .listing-details {
            position: sticky;
            top: 2rem;
        }
        .listing-info {
            background: white;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .info-section {
            margin-bottom: 1.5rem;
        }
        .info-section:last-child {
            margin-bottom: 0;
        }
        .info-section h3 {
            color: #2c3e50;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #eee;
        }
        .info-field {
            display: flex;
            margin-bottom: 0.5rem;
        }
        .info-label {
            width: 120px;
            font-weight: bold;
            color: #7f8c8d;
        }
        .info-value {
            flex: 1;
            color: #2c3e50;
        }
        .action-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }
        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }
        .btn-primary {
            background: #3498db;
            color: white;
        }
        .btn-primary:hover {
            background: #2980b9;
        }
        .btn-secondary {
            background: #95a5a6;
            color: white;
        }
        .btn-secondary:hover {
            background: #7f8c8d;
        }
        .btn-danger {
            background: #e74c3c;
            color: white;
        }
        .btn-danger:hover {
            background: #c0392b;
        }

        @media (max-width: 768px) {
            .listing-content {
                grid-template-columns: 1fr;
            }
            .listing-photos, .listing-details {
                position: static;
            }
        }

        .photo-actions {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
            padding: 0.5rem;
            background: white;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .action-icon {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
            background: none;
            color: #7f8c8d;
        }

        .action-icon:hover {
            background: #f8f9fa;
            color: #3498db;
        }

        .action-icon.active {
            color: #e74c3c;
        }

        .action-icon i {
            font-size: 1.2rem;
        }

        .action-icon span {
            font-size: 0.9rem;
        }

        .rating-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .rating-content {
            background: white;
            padding: 2rem;
            border-radius: 10px;
            width: 90%;
            max-width: 400px;
        }

        .rating-stars {
            display: flex;
            gap: 0.5rem;
            margin: 1rem 0;
            font-size: 1.5rem;
        }

        .rating-stars i {
            cursor: pointer;
            color: #ddd;
        }

        .rating-stars i.active {
            color: #f1c40f;
        }

        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            margin-top: 1rem;
        }

        .photo-viewer-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .photo-viewer-content {
            position: relative;
            width: 90%;
            height: 90%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .photo-viewer-image {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .photo-viewer-nav {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 100%;
            display: flex;
            justify-content: space-between;
            padding: 0 2rem;
        }

        .photo-viewer-nav button {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            padding: 1rem;
            cursor: pointer;
            border-radius: 50%;
            transition: background 0.3s ease;
        }

        .photo-viewer-nav button:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .photo-viewer-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            padding: 0.5rem 1rem;
            cursor: pointer;
            border-radius: 5px;
            transition: background 0.3s ease;
        }

        .photo-viewer-close:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .photo-viewer-counter {
            position: absolute;
            bottom: 1rem;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            background: rgba(0, 0, 0, 0.5);
            padding: 0.5rem 1rem;
            border-radius: 20px;
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <div class="logo">
                <h1>Dwelly</h1>
            </div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/favorites">Favorites</a>
                <a href="/users/profile">Profile</a>
                <a href="/auth/logout">Logout</a>
            </div>
        </nav>
    </header>

    <main>
        <div class="listing-container">
            <% if (success) { %>
                <div class="success-message">
                    <%= success %>
                </div>
            <% } %>

            <div class="listing-header">
                <h1 class="listing-title"><%= listing.type %></h1>
                <div class="listing-meta">
                    Posted by <%= listing.poster_name %> • 
                    <%= new Date(listing.created_at).toLocaleDateString() %>
                </div>
            </div>

            <div class="listing-content">
                <div class="listing-photos">
                    <% if (photos && photos.length > 0) { %>
                        <img src="<%= photos[0].file_path %>" alt="Main photo" class="main-photo">
                        <div class="photo-grid">
                            <% photos.forEach((photo, index) => { %>
                                <img src="<%= photo.file_path %>" alt="Photo <%= index + 1 %>" class="photo-thumbnail">
                            <% }); %>
                        </div>
                    <% } else { %>
                        <img src="/images/no-image.jpg" alt="No photo available" class="main-photo">
                    <% } %>

                    <% if (user) { %>
                        <div class="photo-actions">
                            <% if (user.id !== listing.user_id) { %>
                                <button class="action-icon <%= isFavorited ? 'active' : '' %>" id="favoriteBtn" data-post-id="<%= listing.post_id %>">
                                    <i class="fas fa-bookmark"></i>
                                    <span><%= listing.favorite_count || 0 %></span>
                                </button>
                                <button class="action-icon" id="rateBtn">
                                    <i class="fas fa-star"></i>
                                    <span><%= listing.average_rating ? listing.average_rating.toFixed(1) : 'Rate' %></span>
                                </button>
                                <button class="action-icon" id="reportBtn">
                                    <i class="fas fa-flag"></i>
                                </button>
                            <% } else { %>
                                <button class="action-icon" id="editBtn" data-post-id="<%= listing.post_id %>">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="action-icon" id="deleteBtn" data-post-id="<%= listing.post_id %>">
                                    <i class="fas fa-trash"></i>
                                </button>
                            <% } %>
                        </div>
                    <% } %>

                    <!-- New Map Section -->
                    <div class="info-section" style="margin-top: 2rem;">
                        <h3>Map</h3>
                        <% if (listing.latitude && listing.longitude) { %>
                            <div id="listingMap" style="height: 400px; width: 100%; border: 2px solid #3498db; border-radius: 10px; background-color: #f8f9fa;"></div>
                        <% } else { %>
                            <div style="padding: 2rem; color: #7f8c8d; text-align: center;">No location set for this listing.</div>
                        <% } %>
                        <button class="btn btn-primary" style="margin-top: 1rem;" onclick="window.open('https://www.google.com/maps/dir/?api=1&origin=<%= listing.latitude %>,<%= listing.longitude %>&destination=7.062694,125.596000', '_blank');">Directions to School</button>
                    </div>
                </div>

                <div class="listing-details">
                    <div class="listing-info">
                        <div class="info-section">
                            <h3>Description</h3>
                            <p><%= listing.description || 'No description provided' %></p>
                        </div>

                        <div class="info-section">
                            <h3>Location</h3>
                            <div class="info-field">
                                <div class="info-label">Street</div>
                                <div class="info-value"><%= listing.street %></div>
                            </div>
                            <div class="info-field">
                                <div class="info-label">Barangay</div>
                                <div class="info-value"><%= listing.barangay %></div>
                            </div>
                            <div class="info-field">
                                <div class="info-label">City</div>
                                <div class="info-value"><%= listing.city %></div>
                            </div>
                            <% if (listing.building_name) { %>
                                <div class="info-field">
                                    <div class="info-label">Building</div>
                                    <div class="info-value"><%= listing.building_name %></div>
                                </div>
                            <% } %>
                            <% if (listing.unit_number) { %>
                                <div class="info-field">
                                    <div class="info-label">Unit</div>
                                    <div class="info-value"><%= listing.unit_number %></div>
                                </div>
                            <% } %>
                        </div>

                        <div class="info-section">
                            <h3>Amenities</h3>
                            <div class="listing-amenities" style="flex-wrap: wrap; white-space: normal;">
                                <% let hasAmenity = false; %>
                                <% if (listing.has_wifi) { hasAmenity = true; %>
                                    <span style="display: inline-block; background: #e1f0ff; color: #3498db; border-radius: 15px; font-size: 0.75rem; padding: 0.25rem 0.5rem; margin-right: 0.25rem;"><i style="font-size: 0.875rem;" class="fas fa-wifi"></i> WiFi</span>
                                <% } %>
                                <% if (listing.has_cctv) { hasAmenity = true; %>
                                    <span style="display: inline-block; background: #e1f0ff; color: #3498db; border-radius: 15px; font-size: 0.75rem; padding: 0.25rem 0.5rem; margin-right: 0.25rem;"><i style="font-size: 0.875rem;" class="fas fa-video"></i> CCTV</span>
                                <% } %>
                                <% if (listing.is_airconditioned) { hasAmenity = true; %>
                                    <span style="display: inline-block; background: #e1f0ff; color: #3498db; border-radius: 15px; font-size: 0.75rem; padding: 0.25rem 0.5rem; margin-right: 0.25rem;"><i style="font-size: 0.875rem;" class="fas fa-snowflake"></i> AC</span>
                                <% } %>
                                <% if (listing.has_parking) { hasAmenity = true; %>
                                    <span style="display: inline-block; background: #e1f0ff; color: #3498db; border-radius: 15px; font-size: 0.75rem; padding: 0.25rem 0.5rem; margin-right: 0.25rem;"><i style="font-size: 0.875rem;" class="fas fa-parking"></i> Parking</span>
                                <% } %>
                                <% if (listing.has_own_electricity) { hasAmenity = true; %>
                                    <span style="display: inline-block; background: #e1f0ff; color: #3498db; border-radius: 15px; font-size: 0.75rem; padding: 0.25rem 0.5rem; margin-right: 0.25rem;"><i style="font-size: 0.875rem;" class="fas fa-bolt"></i> Own Meter</span>
                                <% } %>
                                <% if (listing.has_own_water) { hasAmenity = true; %>
                                    <span style="display: inline-block; background: #e1f0ff; color: #3498db; border-radius: 15px; font-size: 0.75rem; padding: 0.25rem 0.5rem; margin-right: 0.25rem;"><i style="font-size: 0.875rem;" class="fas fa-tint"></i> Own Water</span>
                                <% } %>
                                <% if (!hasAmenity) { %>
                                    <span style="color: #7f8c8d;">No amenities listed.</span>
                                <% } %>
                            </div>
                        </div>

                        <div class="info-section">
                            <h3>Contact Information</h3>
                            <div class="info-field">
                                <div class="info-label">Landlord</div>
                                <div class="info-value"><%= listing.landlord_name %></div>
                            </div>
                            <div class="info-field">
                                <div class="info-label">Contact</div>
                                <div class="info-value"><%= listing.contact_number %></div>
                            </div>
                            <% if (listing.social_link) { %>
                                <div class="info-field">
                                    <div class="info-label">Social Media</div>
                                    <div class="info-value">
                                        <a href="<%= listing.social_link %>" target="_blank">View Profile</a>
                                    </div>
                                </div>
                            <% } %>
                            <% if (listing.maps_link) { %>
                                <div class="info-field">
                                    <div class="info-label">Map Location</div>
                                    <div class="info-value">
                                        <a href="<%= listing.maps_link %>" target="_blank" rel="noopener">View on Map</a>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                        <% if (listing.price) { %>
                            <div class="info-section">
                                <h3>Price</h3>
                                <div class="info-value">₱<%= listing.price.toLocaleString() %>/month</div>
                            </div>
                        <% } %>

                        <div class="info-section">
                            <h3>Statistics</h3>
                            <div class="info-field">
                                <div class="info-label">Favorites</div>
                                <div class="info-value"><%= listing.favorite_count || 0 %></div>
                            </div>
                            <div class="info-field">
                                <div class="info-label">Rating</div>
                                <div class="info-value">
                                    <% if (listing.average_rating) { %>
                                        <%= listing.average_rating.toFixed(1) %>/5.0
                                        (<%= listing.rating_count %> reviews)
                                    <% } else { %>
                                        No ratings yet
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <% if (!user) { %>
                            <div class="info-section">
                                <a href="/auth/login" class="btn btn-primary">Login to Interact</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; 2024 Dwelly. All rights reserved.</p>
    </footer>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        (function() {
            <% if (listing.latitude && listing.longitude) { %>
            var lat = <%= listing.latitude %>;
            var lng = <%= listing.longitude %>;
            var popupText = "<%= listing.barangay + ', ' + listing.city %>";
            var map = L.map('listingMap').setView([lat, lng], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap contributors' }).addTo(map);
            L.marker([lat, lng]).addTo(map).bindPopup(popupText).openPopup();
            setTimeout(function() { map.invalidateSize(); }, 100);
            <% } %>
        })();
    });
    </script>
</body>
</html> 