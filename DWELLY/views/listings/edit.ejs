<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        main {
            flex: 1 0 auto;
            padding-bottom: 2rem;
        }
        footer {
            flex-shrink: 0;
            background: #2c3e50;
            color: white;
            text-align: center;
            padding: 1rem;
            margin-top: auto;
            width: 100%;
            position: relative;
            bottom: 0;
        }
        .form-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 2rem;
        }
        .form-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        .form-card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            padding: 2rem;
            margin-bottom: 2rem;
        }
        .form-section {
            margin-bottom: 1.5rem;
        }
        .form-section:last-child {
            margin-bottom: 0;
        }
        .form-section h3 {
            color: #2c3e50;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #eee;
        }
        .form-group {
            margin-bottom: 1.5rem;
        }
        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: bold;
            color: #2c3e50;
        }
        .form-label.required::after {
            content: " *";
            color: #e74c3c;
        }
        .form-control {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }
        .form-control:focus {
            border-color: #3498db;
            outline: none;
        }
        .form-text {
            font-size: 0.875rem;
            color: #7f8c8d;
            margin-top: 0.25rem;
        }
        .photo-upload {
            border: 2px dashed #ddd;
            border-radius: 5px;
            padding: 2rem;
            text-align: center;
            margin-bottom: 1rem;
            cursor: pointer;
            transition: border-color 0.3s ease;
        }
        .photo-upload:hover {
            border-color: #3498db;
        }
        .photo-preview {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }
        .photo-item {
            position: relative;
            height: 150px;
            border-radius: 5px;
            overflow: hidden;
        }
        .photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .photo-remove {
            position: absolute;
            top: 5px;
            right: 5px;
            background: rgba(0,0,0,0.5);
            color: white;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .btn {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        .btn-primary {
            background: #3498db;
            color: white;
        }
        .btn-primary:hover {
            background: #2980b9;
        }
        .btn-secondary {
            background: #95a5a6;
            color: white;
        }
        .btn-secondary:hover {
            background: #7f8c8d;
        }
        .form-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 2rem;
        }
        .alert {
            padding: 1rem;
            border-radius: 5px;
            margin-bottom: 1rem;
        }
        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        
        /* Enhanced styles for map link section */
        .map-link-container {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
        
        .map-link-container h4 {
            color: #2c3e50;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .map-link-status {
            margin-top: 0.5rem;
            padding: 0.5rem;
            border-radius: 4px;
            font-size: 0.875rem;
        }
        
        .text-success {
            color: #155724;
            background: #d4edda;
            border: 1px solid #c3e6cb;
        }
        
        .text-warning {
            color: #856404;
            background: #fff3cd;
            border: 1px solid #ffeaa7;
        }
        
        .text-danger {
            color: #721c24;
            background: #f8d7da;
            border: 1px solid #f5c6cb;
        }
        
        .text-info {
            color: #0c5460;
            background: #d1ecf1;
            border: 1px solid #bee5eb;
        }
        
        .btn-outline-primary {
            background: transparent;
            color: #3498db;
            border: 1px solid #3498db;
        }
        
        .btn-outline-primary:hover {
            background: #3498db;
            color: white;
        }
        
        .btn-sm {
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
        }
        
        .location-inputs-container {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
        
        .auto-filled {
            background-color: #d4edda !important;
            border-color: #28a745 !important;
            transition: all 0.3s ease;
        }
        
        .coordinate-inputs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        
        .amenities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 0.5rem;
        }
        
        .amenity-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .amenity-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
        }
        
        .amenity-item label {
            margin: 0;
            font-weight: normal;
        }
        
        @media (max-width: 768px) {
            .coordinate-inputs {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <div class="logo">
                <h1>Dwelly</h1>
            </div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/favorites">Favorites</a>
                <a href="/users/profile">Profile</a>
                <a href="/auth/logout">Logout</a>
            </div>
        </nav>
    </header>

    <main>
        <div class="form-container">
            <div class="form-header">
                <h1>Edit Listing</h1>
                <p>Update your student housing listing details</p>
            </div>

            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger">
                    <ul style="margin: 0; padding-left: 1rem;">
                        <% errors.forEach(function(error) { %>
                            <li><%= error %></li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>

            <form action="/listings/<%= listing.post_id %>/edit" method="POST" enctype="multipart/form-data" id="listingForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                
                <div class="form-card">
                    <div class="form-section">
                        <h3>Photos</h3>
                        <div class="form-group">
                            <label class="form-label">Current Photos</label>
                            <div class="photo-preview" id="currentPhotos">
                                <% if (listing.photos && listing.photos.length > 0) { %>
                                    <% listing.photos.forEach(function(photo, index) { %>
                                        <div class="photo-item" data-photo-index="<%= index %>">
                                            <img src="<%= photo %>" alt="Current photo">
                                            <button type="button" class="photo-remove" onclick="removeCurrentPhoto(<%= index %>)">×</button>
                                            <input type="hidden" name="keep_photos[]" value="<%= photo.split('/').pop() %>">
                                        </div>
                                    <% }); %>
                                <% } %>
                            </div>
                            <div class="form-text">Click the × button to remove photos you don't want to keep.</div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Add New Photos (Optional)</label>
                            <div class="photo-upload" id="photoUpload">
                                <p>Click to select additional photos or drag and drop</p>
                                <input type="file" name="new_photos" id="photos" multiple accept="image/*" style="display: none;">
                            </div>
                            <div class="photo-preview" id="photoPreview"></div>
                            <div class="form-text">Add more photos to your listing. Total photos (existing + new) cannot exceed 6. Supported formats: JPG, PNG, WebP. Max size: 5MB per image.</div>
                        </div>
                    </div>

                    <!-- Enhanced Map Link Section -->
                    <div class="form-section">
                        <div class="map-link-container">
                            <h4>🗺️ Update Location Quickly</h4>
                            <p style="margin-bottom: 1rem; color: #6c757d;">Paste a new Google Maps or Apple Maps link to automatically update location details below.</p>
                            
                            <div class="form-group">
                                <label class="form-label" for="maps_link">Map Link (Optional)</label>
                                <input type="url" 
                                       class="form-control" 
                                       id="maps_link" 
                                       name="maps_link" 
                                       value="<%= formData.maps_link || '' %>"
                                       placeholder="Paste Google Maps or Apple Maps link here...">
                                <!-- Status and extract button will be added here by JavaScript -->
                            </div>
                            
                            <div class="form-text">
                                <strong>Supported formats:</strong><br>
                                • Google Maps: https://www.google.com/maps/place/...<br>
                                • Google Maps (short): https://maps.app.goo.gl/...<br>
                                • Apple Maps: https://maps.apple.com/?ll=...
                            </div>
                        </div>
                    </div>

                    <!-- Enhanced Location Information Section -->
                    <div class="form-section">
                        <div class="location-inputs-container">
                            <h3>📍 Location Information</h3>
                            <p style="margin-bottom: 1.5rem; color: #6c757d;">
                                These fields can be automatically updated using the map link above, or you can edit them manually.
                            </p>
                            
                            <div class="form-group">
                                <label class="form-label required" for="street">Street Address</label>
                                <input type="text" 
                                       class="form-control" 
                                       id="street" 
                                       name="street" 
                                       required 
                                       value="<%= formData.street %>"
                                       placeholder="e.g., 123 Juan Luna Street">
                                <div class="form-text">The specific street address of the property.</div>
                            </div>

                            <div class="form-group">
                                <label class="form-label required" for="barangay">Barangay</label>
                                <input type="text" 
                                       class="form-control" 
                                       id="barangay" 
                                       name="barangay" 
                                       required 
                                       value="<%= formData.barangay || '' %>"
                                       placeholder="e.g., Poblacion District">
                                <div class="form-text">The barangay where the property is located.</div>
                            </div>

                            <div class="form-group">
                                <label class="form-label required" for="city">City</label>
                                <input type="text" 
                                       class="form-control" 
                                       id="city" 
                                       name="city" 
                                       required 
                                       value="<%= formData.city || 'Davao City' %>"
                                       placeholder="Davao City">
                                <div class="form-text">The city where the property is located.</div>
                            </div>
                            
                            <div class="coordinate-inputs">
                                <div class="form-group">
                                    <label class="form-label" for="latitude">Latitude</label>
                                    <input type="number" 
                                           class="form-control" 
                                           id="latitude" 
                                           name="latitude" 
                                           step="any" 
                                           min="4" 
                                           max="21"
                                           value="<%= formData.latitude || '' %>"
                                           placeholder="7.0724147">
                                    <div class="form-text">Latitude coordinate (automatically filled from map link).</div>
                                </div>
                                
                                <div class="form-group">
                                    <label class="form-label" for="longitude">Longitude</label>
                                    <input type="number" 
                                           class="form-control" 
                                           id="longitude" 
                                           name="longitude" 
                                           step="any" 
                                           min="116" 
                                           max="127"
                                           value="<%= formData.longitude || '' %>"
                                           placeholder="125.61276">
                                    <div class="form-text">Longitude coordinate (automatically filled from map link).</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3>Property Details</h3>
                        <div class="form-group">
                            <label class="form-label required" for="type_id">Type of Rental</label>
                            <select class="form-control" id="type_id" name="type_id" required>
                                <option value="">Select a type</option>
                                <% roomTypes.forEach(function(type) { %>
                                    <option value="<%= type.type_id %>" <%= formData.type_id == type.type_id ? 'selected' : '' %>>
                                        <%= type.display_name %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="price">Monthly Rent (PHP)</label>
                            <input type="number" class="form-control" id="price" name="price" min="0" step="0.01" value="<%= formData.price || '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="building_name">Building Name (if applicable)</label>
                            <input type="text" class="form-control" id="building_name" name="building_name" value="<%= formData.building_name || '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="unit_number">Unit Number (if applicable)</label>
                            <input type="text" class="form-control" id="unit_number" name="unit_number" value="<%= formData.unit_number || '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label required" for="number_of_rooms">Number of Rooms</label>
                            <input type="number" class="form-control" id="number_of_rooms" name="number_of_rooms" min="1" required value="<%= formData.number_of_rooms || '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label required" for="bathroom_type">Bathroom Type</label>
                            <select class="form-control" id="bathroom_type" name="bathroom_type" required>
                                <option value="">Select bathroom type</option>
                                <option value="common" <%= formData.bathroom_type === 'common' ? 'selected' : '' %>>Common Bathroom</option>
                                <option value="own" <%= formData.bathroom_type === 'own' ? 'selected' : '' %>>Own Bathroom</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label required" for="room_type">Room Type</label>
                            <select class="form-control" id="room_type" name="room_type" required>
                                <option value="">Select room type</option>
                                <option value="bare" <%= formData.room_type === 'bare' ? 'selected' : '' %>>Bare Room</option>
                                <option value="semi_furnished" <%= formData.room_type === 'semi_furnished' ? 'selected' : '' %>>Semi-Furnished</option>
                                <option value="furnished" <%= formData.room_type === 'furnished' ? 'selected' : '' %>>Furnished</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Amenities</label>
                            <div class="amenities-grid">
                                <div class="amenity-item">
                                    <input type="checkbox" id="has_wifi" name="has_wifi" <%= formData.has_wifi ? 'checked' : '' %>>
                                    <label for="has_wifi">WiFi</label>
                                </div>
                                <div class="amenity-item">
                                    <input type="checkbox" id="has_cctv" name="has_cctv" <%= formData.has_cctv ? 'checked' : '' %>>
                                    <label for="has_cctv">CCTV</label>
                                </div>
                                <div class="amenity-item">
                                    <input type="checkbox" id="is_airconditioned" name="is_airconditioned" <%= formData.is_airconditioned ? 'checked' : '' %>>
                                    <label for="is_airconditioned">Airconditioned</label>
                                </div>
                                <div class="amenity-item">
                                    <input type="checkbox" id="has_parking" name="has_parking" <%= formData.has_parking ? 'checked' : '' %>>
                                    <label for="has_parking">Parking</label>
                                </div>
                                <div class="amenity-item">
                                    <input type="checkbox" id="has_own_electricity" name="has_own_electricity" <%= formData.has_own_electricity ? 'checked' : '' %>>
                                    <label for="has_own_electricity">Own Electricity Meter</label>
                                </div>
                                <div class="amenity-item">
                                    <input type="checkbox" id="has_own_water" name="has_own_water" <%= formData.has_own_water ? 'checked' : '' %>>
                                    <label for="has_own_water">Own Water Meter</label>
                                </div>
                            </div>
                            <div class="form-group" style="margin-top:1rem;">
                                <label class="form-label">Other Amenities</label>
                                <div style="display:flex; gap:0.5rem;">
                                    <input type="text" id="customAmenityInput" class="form-control" placeholder="Add custom amenity...">
                                    <button type="button" id="addCustomAmenity" class="btn btn-secondary">Add</button>
                                </div>
                                <div id="customAmenitiesList" style="margin-top:0.5rem; display:flex; flex-wrap:wrap; gap:0.5rem;"></div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="description">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="4"><%= listing.description %></textarea>
                            <div class="form-text">Describe the property, its features, and any important details potential tenants should know.</div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3>Interactive Map</h3>
                        <div class="form-group">
                            <label class="form-label">Pinpoint Location on Map</label>
                            <div id="map" style="height: 400px; margin-bottom: 1rem;"></div>
                            <div class="form-text">Click on the map to adjust the exact location of your property, or the map will automatically update when you extract location from a map link above.</div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3>Contact Information</h3>
                        <div class="form-group">
                            <label class="form-label required" for="landlord_name">Landlord Full Name</label>
                            <input type="text" class="form-control" id="landlord_name" name="landlord_name" required value="<%= formData.landlord_name %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label required" for="contact_number">Contact Number</label>
                            <input type="tel" class="form-control" id="contact_number" name="contact_number" required value="<%= formData.contact_number %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="social_media_link">Social Media Link (Optional)</label>
                            <input type="url" class="form-control" id="social_media_link" name="social_media_link" placeholder="https://facebook.com/..." value="<%= formData.social_link || '' %>">
                            <div class="form-text">Add a link to your Facebook, Instagram, or other social media profile.</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/listings/<%= listing.post_id %>" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Update Listing</button>
                    </div>
                </div>
            </form>
        </div>
    </main>

    <footer>
        <p>&copy; 2024 Dwelly. All rights reserved.</p>
    </footer>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    
    <!-- Include the Location Extractor JavaScript -->
    <script src="/js/locationExtractor.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const photoUpload = document.getElementById('photoUpload');
            const photosInput = document.getElementById('photos');
            const photoPreview = document.getElementById('photoPreview');
            const listingForm = document.getElementById('listingForm');
            
            // Handle photo upload click
            photoUpload.addEventListener('click', function() {
                photosInput.click();
            });
            
            // Handle file selection
            photosInput.addEventListener('change', updatePhotoPreview);
            
            // Update photo preview
            function updatePhotoPreview() {
                photoPreview.innerHTML = '';
                
                for (let i = 0; i < photosInput.files.length; i++) {
                    const file = photosInput.files[i];
                    const reader = new FileReader();
                    
                    reader.onload = function(e) {
                        const photoItem = document.createElement('div');
                        photoItem.className = 'photo-item';
                        
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        
                        const removeBtn = document.createElement('button');
                        removeBtn.className = 'photo-remove';
                        removeBtn.innerHTML = '&times;';
                        removeBtn.addEventListener('click', function() {
                            // Create a new FileList without this file
                            const dt = new DataTransfer();
                            const { files } = photosInput;
                            
                            for (let j = 0; j < files.length; j++) {
                                if (j !== i) {
                                    dt.items.add(files[j]);
                                }
                            }
                            
                            photosInput.files = dt.files;
                            updatePhotoPreview();
                        });
                        
                        photoItem.appendChild(img);
                        photoItem.appendChild(removeBtn);
                        photoPreview.appendChild(photoItem);
                    };
                    
                    reader.readAsDataURL(file);
                }
            }

            // Initialize map
            const map = L.map('map').setView([<%= formData.latitude || 7.0633 %>, <%= formData.longitude || 125.5956 %>], 14);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 18,
                minZoom: 12
            }).addTo(map);

            // Add Mapúa marker
            const mapuaMarker = L.marker([7.0633, 125.5956]).addTo(map);
            mapuaMarker.bindPopup('<strong>Mapúa Malayan Colleges Mindanao</strong><br>Reference point for student housing');

            let marker = null;
            const latitudeInput = document.getElementById('latitude');
            const longitudeInput = document.getElementById('longitude');

            // Function to update marker and inputs
            function updateMarker(latlng) {
                if (marker) {
                    marker.setLatLng(latlng);
                } else {
                    marker = L.marker(latlng, {
                        draggable: true
                    }).addTo(map);
                    
                    // Add drag end event
                    marker.on('dragend', function(e) {
                        const newLatLng = e.target.getLatLng();
                        updateInputs(newLatLng);
                    });
                }
                updateInputs(latlng);
                map.setView(latlng, 15);
            }

            // Function to update input values
            function updateInputs(latlng) {
                latitudeInput.value = latlng.lat.toFixed(6);
                longitudeInput.value = latlng.lng.toFixed(6);
            }

            // Add marker if coordinates exist
            if (latitudeInput.value && longitudeInput.value) {
                updateMarker([latitudeInput.value, longitudeInput.value]);
            }

            // Handle map click
            map.on('click', function(e) {
                const latlng = e.latlng;
                // Only allow clicks within Davao City bounds
                if (latlng.lat >= 7.0 && latlng.lat <= 7.2 && 
                    latlng.lng >= 125.4 && latlng.lng <= 125.7) {
                    updateMarker(latlng);
                } else {
                    alert('Please select a location within Davao City');
                }
            });

            // Enhanced map integration with location extractor
            // Listen for coordinate updates from location extraction
            const coordInputs = [latitudeInput, longitudeInput];
            coordInputs.forEach(input => {
                input.addEventListener('change', function() {
                    const lat = parseFloat(latitudeInput.value);
                    const lng = parseFloat(longitudeInput.value);
                    
                    if (!isNaN(lat) && !isNaN(lng)) {
                        updateMarker([lat, lng]);
                    }
                });
            });

            // Listen for the custom locationExtracted event from the location extractor
            document.addEventListener('locationExtracted', function(event) {
                const { latitude, longitude } = event.detail;
                console.log('🗺️ Map received location update:', { latitude, longitude });
                
                // Validate coordinates are within Philippines bounds
                if (latitude >= 4 && latitude <= 21 && longitude >= 116 && longitude <= 127) {
                    updateMarker([latitude, longitude]);
                    
                    // Show a brief notification on the map
                    const notification = L.popup()
                        .setLatLng([latitude, longitude])
                        .setContent('<div style="text-align: center;"><strong>📍 Location Updated!</strong><br>Coordinates auto-filled from map link</div>')
                        .openOn(map);
                    
                    // Close notification after 3 seconds
                    setTimeout(() => {
                        map.closePopup(notification);
                    }, 3000);
                } else {
                    console.warn('⚠️ Extracted coordinates outside Philippines bounds:', { latitude, longitude });
                }
            });

            // Custom amenities logic
            const customAmenityInput = document.getElementById('customAmenityInput');
            const addCustomAmenityBtn = document.getElementById('addCustomAmenity');
            const customAmenitiesList = document.getElementById('customAmenitiesList');

            // Load existing custom amenities
            let customAmenities = [];
            <% if (listing.allAmenities) { %>
                <% listing.allAmenities.forEach(function(amenity) { %>
                    <% if (amenity.amenity_type === 'custom') { %>
                        customAmenities.push('<%= amenity.amenity_name %>');
                    <% } %>
                <% }); %>
            <% } %>
            
            renderCustomAmenities();

            addCustomAmenityBtn.addEventListener('click', function() {
                const value = customAmenityInput.value.trim();
                if (value && !customAmenities.includes(value)) {
                    customAmenities.push(value);
                    renderCustomAmenities();
                    customAmenityInput.value = '';
                }
            });

            function renderCustomAmenities() {
                customAmenitiesList.innerHTML = '';
                customAmenities.forEach((amenity, idx) => {
                    const tag = document.createElement('span');
                    tag.className = 'amenity-tag';
                    tag.textContent = amenity;
                    tag.style.cssText = 'background: #3498db; color: white; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.875rem; margin: 0.25rem;';
                    
                    const removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.textContent = '×';
                    removeBtn.style.marginLeft = '0.5rem';
                    removeBtn.style.background = 'none';
                    removeBtn.style.border = 'none';
                    removeBtn.style.color = 'white';
                    removeBtn.style.cursor = 'pointer';
                    removeBtn.onclick = function() {
                        customAmenities.splice(idx, 1);
                        renderCustomAmenities();
                    };
                    tag.appendChild(removeBtn);
                    customAmenitiesList.appendChild(tag);
                });
            }

            // On form submit, add custom amenities as hidden inputs
            listingForm.addEventListener('submit', function() {
                // Remove any previous hidden inputs
                document.querySelectorAll('input[name="custom_amenities[]"]').forEach(e => e.remove());
                
                if (customAmenities.length > 0) {
                    customAmenities.forEach(amenity => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'custom_amenities[]';
                        input.value = amenity;
                        listingForm.appendChild(input);
                    });
                }
            });
        });

        // Function to remove current photos
        function removeCurrentPhoto(index) {
            const photoItem = document.querySelector(`[data-photo-index="${index}"]`);
            if (photoItem) {
                photoItem.remove();
            }
        }
    </script>
</body>
</html> 