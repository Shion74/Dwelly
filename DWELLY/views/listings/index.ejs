<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        main {
            flex: 1 0 auto;
            padding-bottom: 2rem;
        }
        footer {
            flex-shrink: 0;
            background: #2c3e50;
            color: white;
            text-align: center;
            padding: 1rem;
            margin-top: auto;
            width: 100%;
            position: relative;
            bottom: 0;
        }
        .listings-container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 2rem;
        }
        .listings-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 2rem;
        }
        .listing-card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            height: 100%;
        }
        .listing-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        .listing-photo-container {
            position: relative;
            width: 100%;
            height: 200px;
            background-color: #f5f6fa;
            overflow: hidden;
        }
        .listing-photo {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .listing-photo.loaded {
            opacity: 1;
        }
        .photo-placeholder {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f5f6fa;
            color: #95a5a6;
        }
        .photo-placeholder i {
            font-size: 2rem;
        }
        .listing-content {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex: 1;
            justify-content: space-between;
        }
        .listing-title {
            font-size: 1.25rem;
            color: #2c3e50;
            margin-bottom: 0.75rem;
            font-weight: 600;
            line-height: 1.4;
        }
        .listing-meta {
            color: #7f8c8d;
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }
        .listing-price {
            font-size: 1.5rem;
            color: #27ae60;
            font-weight: bold;
            margin-bottom: 0.75rem;
        }
        .listing-location {
            color: #7f8c8d;
            font-size: 0.9rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .listing-amenities {
            display: flex;
            flex-wrap: nowrap;
            gap: 0.5rem;
            margin: 0.5rem 0;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            width: 100%;
        }
        .amenity-tag {
            display: inline-block;
            align-items: center;
            gap: 0.25rem;
            background: #e1f0ff;
            color: #3498db;
            border-radius: 15px;
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            margin-right: 0.25rem;
        }
        .amenity-tag i {
            font-size: 0.875rem;
        }
        .room-type-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background: #e1f0ff;
            color: #3498db;
            border-radius: 15px;
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
        }
        .bathroom-type-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background: #fff3e0;
            color: #f39c12;
            border-radius: 15px;
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
        }
        .listing-stats {
            display: flex;
            gap: 1.5rem;
            color: #7f8c8d;
            font-size: 0.9rem;
            margin-top: auto;
            padding-top: 1rem;
            border-top: 1px solid #eee;
        }
        .stat {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .stat i {
            color: #3498db;
        }
        .no-listings {
            text-align: center;
            padding: 3rem;
            color: #7f8c8d;
        }
        .create-listing-btn {
            display: inline-block;
            background: #3498db;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 5px;
            text-decoration: none;
            margin-top: 1rem;
            transition: background 0.3s ease;
        }
        .create-listing-btn:hover {
            background: #2980b9;
        }
        .status-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            padding: 0.25rem 0.5rem;
            border-radius: 5px;
            font-size: 0.875rem;
        }
        .available-badge {
            background: #27ae60;
            color: white;
        }
    </style>
    <!-- Add Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <header>
        <nav>
            <div class="logo">
                <h1>Dwelly</h1>
            </div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/favorites">Favorites</a>
                <a href="/users/profile">Profile</a>
                <a href="/auth/logout">Logout</a>
            </div>
        </nav>
    </header>

    <main>
        <div class="listings-container">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <h1>All Listings</h1>
                <% if (user) { %>
                    <a href="/listings/create" class="create-listing-btn">Create Listing</a>
                <% } %>
            </div>

            <% if (listings && listings.length > 0) { %>
                <div class="listings-grid">
                    <% listings.forEach(listing => { %>
                        <a href="/listings/<%= listing.post_id %>" class="listing-card">
                            <div class="listing-photo-container">
                                <% if (listing.photos && listing.photos.length > 0) { %>
                                    <img src="<%= listing.photos[0] %>" 
                                         alt="<%= listing.type %>" 
                                         class="listing-photo"
                                         onload="this.classList.add('loaded')"
                                         onerror="this.src='/images/no-image.jpg'; this.classList.add('loaded')">
                                <% } else { %>
                                    <div class="photo-placeholder">
                                        <i class="fas fa-home"></i>
                                    </div>
                                <% } %>
                                <% if (listing.status === 'available') { %>
                                    <span class="status-badge available-badge">Available</span>
                                <% } %>
                            </div>
                            <div class="listing-content">
                                <div>
                                    <h2 class="listing-title"><%= listing.type %></h2>
                                    <div class="listing-meta">
                                        Posted by <%= listing.poster_name %> • 
                                        <%= new Date(listing.created_at).toLocaleDateString() %>
                                    </div>
                                    <% if (listing.room_type) { %>
                                        <span class="room-type-badge"><i class="fas fa-door-open"></i> <%= listing.room_type %></span>
                                    <% } %>
                                    <% if (listing.bathroom_type) { %>
                                        <span class="bathroom-type-badge"><i class="fas fa-bath"></i> <%= listing.bathroom_type %></span>
                                    <% } %>
                                    <% if (listing.price) { %>
                                        <div class="listing-price">₱<%= listing.price.toLocaleString() %>/month</div>
                                    <% } %>
                                    <div class="listing-location">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <%= listing.barangay %>, <%= listing.city %>
                                    </div>
                                    <div class="listing-amenities">
                                        <% let amenityCount = 0; %>
                                        <% if (typeof listing.allAmenities !== 'undefined' && listing.allAmenities.length > 0) { 
                                            listing.allAmenities.forEach(amenity => { 
                                                if (amenityCount < 4) {
                                                    amenityCount++;
                                                    // Choose icon based on amenity name
                                                    let icon = 'fas fa-check';
                                                    const amenityName = amenity.amenity_name.toLowerCase();
                                                    if (amenityName.includes('wifi')) icon = 'fas fa-wifi';
                                                    else if (amenityName.includes('cctv')) icon = 'fas fa-video';
                                                    else if (amenityName.includes('air') || amenityName.includes('ac')) icon = 'fas fa-snowflake';
                                                    else if (amenityName.includes('parking')) icon = 'fas fa-parking';
                                                    else if (amenityName.includes('electricity')) icon = 'fas fa-bolt';
                                                    else if (amenityName.includes('water')) icon = 'fas fa-tint';
                                        %>
                                            <span class="amenity-tag default-amenity">
                                                <i class="<%= icon %>"></i> <%= amenity.amenity_name %>
                                            </span>
                                        <% } 
                                            });
                                            if (listing.allAmenities.length > 4) { %>
                                                <span class="amenity-tag">+<%= listing.allAmenities.length - 4 %> more</span>
                                        <% }
                                        } else { %>
                                            <span class="no-amenities">No amenities listed</span>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="listing-stats">
                                    <div class="stat">
                                        <i class="fas fa-bookmark"></i>
                                        <%= listing.favorite_count %> favorites
                                    </div>
                                    <div class="stat">
                                        <i class="fas fa-star"></i>
                                        <%= listing.average_rating ? listing.average_rating.toFixed(1) : 'No ratings' %>
                                        <% if (listing.rating_count > 0) { %>
                                            (<%= listing.rating_count %>)
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </a>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <h2>No Listings Available</h2>
                    <p>Be the first to post a listing!</p>
                    <% if (user) { %>
                        <a href="/listings/create" class="create-listing-btn">Create Listing</a>
                    <% } else { %>
                        <p>Please log in to create a listing.</p>
                    <% } %>
                </div>
            <% } %>
        </div>
    </main>

    <footer>
        <p>&copy; 2024 Dwelly. All rights reserved.</p>
    </footer>
</body>
</html> 